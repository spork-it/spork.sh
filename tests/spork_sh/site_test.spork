(ns spork-sh.site-test
  (:require
    [spork-sh.site :as subject]
    [spork-site.build :as build]))

(defn plan-entry [plan route]
  (first
    (filter (fn [entry]
              (= (get entry :route) route))
            plan)))

(deftest production-site-has-complete-route-and-asset-plan
  (let [site (subject.make-site)
        summary (build.check-site site)
        routes (into #{} (map :route (build.site-routes site)))
        targets (into #{} (map :target (:plan summary)))]
    (assert (= (:pages summary) 83))
    (assert (= (:assets summary) 6))
    (assert (contains? targets "CNAME"))
    (assert (contains? targets "install"))
    (assert (contains? targets "docs-search.js"))
    (assert (contains? targets "theme.js"))
    (assert (contains? routes "/"))
    (assert (contains? routes "/404.html"))
    (assert (contains? routes "/docs/"))
    (assert (contains? routes "/get/"))
    (assert (contains? routes "/docs/getting-started/"))
    (assert (contains? routes "/docs/language/"))
    (assert (contains? routes "/docs/projects/"))
    (assert (contains? routes "/docs/python-interop/"))
    (assert (contains? routes "/docs/reference/language/"))
    (assert (contains? routes "/docs/reference/language/reader-macros/"))
    (assert (contains? routes "/docs/reference/language/pattern-matching/"))
    (assert (contains? routes "/docs/reference/standard-library/"))
    (assert (not (contains? routes "/docs/reference/standard-library/reader-macros/")))
    (assert (contains? routes "/docs/reference/standard-library/lazy-sequences/"))
    (assert (contains? routes "/docs/reference/standard-library/json/"))
    (assert (contains? routes "/docs/reference/tooling/"))
    (assert (contains? routes "/docs/reference/tooling/command-providers/"))
    (assert (contains? routes "/docs/packages/"))
    (assert (contains? routes "/docs/packages/spork-runtime/"))
    (assert (contains? routes "/docs/packages/spork-pds/api/"))
    (assert (contains? routes "/docs/packages/spork-state/design/"))
    (assert (contains? routes "/docs/packages/spork-site/"))
    (assert (contains? routes "/docs/packages/spork-site/development-server/"))
    (assert (contains? routes "/docs/editors/"))
    (assert (contains? routes "/docs/editors/neovim/"))
    (assert (contains? routes "/docs/examples/"))
    (assert (contains? routes "/docs/examples/static-site/"))
    (assert (not (contains? routes "/ecosystem/")))
    (assert (contains? routes "/install.sha256"))
    (assert (contains? routes "/docs/search/"))
    (assert (contains? routes "/docs/search.json"))
    (assert (contains? routes "/robots.txt"))
    (assert (contains? routes "/sitemap.xml"))))

(deftest homepage-renders-the-production-message-and-navigation
  (let [summary (build.check-site (subject.make-site))
        plan (:plan summary)
        home (.decode (:content (plan-entry plan "/")) "utf-8")
        install (.decode (:content (plan-entry plan "/get/")) "utf-8")]
    (assert (in "<title>Spork — a Lisp hosted on CPython</title>" home))
    (assert (in "a Lisp hosted on CPython" home))
    (assert (in "Spork compiles Lisp forms to Python's AST." home))
    (assert (in "Run a source file." home))
    (assert (in "Import Python directly." home))
    (assert (in "Use expressions, macros, and persistent data." home))
    (assert (in "Add a manifest for a project." home))
    (assert (not (in "./spork" home)))
    (assert (not (in "00 / source" home)))
    (assert (not (in "class=\"section-number\"" home)))
    (assert (in "spork@v0.6.0" home))
    (assert (not (in "class=\"home-status\"" home)))
    (assert (not (in "<dt>release</dt>" home)))
    (assert (not (in "<dt>host</dt>" home)))
    (assert (not (in "<dt>license</dt>" home)))
    (assert (not (in "<dt>status</dt>" home)))
    (assert (in "class=\"language-spork highlight\"" home))
    (assert (in "href=\"/get/\">install Spork →</a>" home))
    (assert (not (in "code map" home)))
    (assert (in "<script src=\"/theme.js\"></script>" home))
    (assert (in "data-theme-toggle" home))
    (assert (in "Built from Spork source with" home))
    (assert (in "<title>Install Spork · Spork</title>" install))
    (assert (in "curl" install))
    (assert (in "https://spork.sh/install" install))
    (assert (in "href=\"/docs/getting-started/\">complete getting-started guide</a>" install))
    (assert (not (in "class=\"section-number\"" install)))
    (assert (not (in "class=\"docs-shell" install)))))

(deftest documentation-pages-render-navigation-anchors-search-and-versions
  (let [summary (build.check-site (subject.make-site))
        plan (:plan summary)
        overview (.decode (:content (plan-entry plan "/docs/")) "utf-8")
        packages (.decode (:content (plan-entry plan "/docs/packages/")) "utf-8")
        language (.decode (:content (plan-entry plan "/docs/language/")) "utf-8")
        lexical (.decode (:content (plan-entry plan "/docs/reference/language/lexical-syntax/")) "utf-8")
        reader-macros (.decode (:content (plan-entry plan "/docs/reference/language/reader-macros/")) "utf-8")
        manifest (.decode (:content (plan-entry plan "/docs/reference/tooling/manifest/")) "utf-8")
        pds (.decode (:content (plan-entry plan "/docs/packages/spork-pds/api/")) "utf-8")
        search (.decode (:content (plan-entry plan "/docs/search/")) "utf-8")
        search-index (.decode (:content (plan-entry plan "/docs/search.json")) "utf-8")]
    (assert (in "class=\"docs-directory\"" overview))
    (assert (in "Browse documentation" overview))
    (assert (in "independently versioned" packages))
    (assert (not (in "spork-lang 0.6.0" packages)))
    (assert (in "<details class=\"sidebar-group\" open>" language))
    (assert (< (language.index "sidebar-search")
               (language.index "sidebar-group")))
    (assert (in "<div class=\"documentation-table\"><table>" manifest))
    (assert (in "<details class=\"sidebar-subgroup\" open>" pds))
    (assert (in "href=\"/docs/packages/\">Packages</a>" pds))
    (assert (in "href=\"/docs/packages/spork-pds/\">spork-pds</a>" pds))
    (assert (in "class=\"breadcrumbs\"" language))
    (assert (not (in "class=\"section-number\"" language)))
    (assert (in "class=\"page-toc\"" language))
    (assert (in "id=\"values-and-calls\"" language))
    (assert (in "href=\"#values-and-calls\"" language))
    (assert (in "spork-lang 0.6.0" language))
    (assert (in "class=\"docs-pagination\"" language))
    (assert (in "href=\"/docs/reference/language/reader-macros/\"" lexical))
    (assert (in "id=\"reader-prefixes\"" lexical))
    (assert (in "id=\"quote\"" reader-macros))
    (assert (in "id=\"anonymous-functions\"" reader-macros))
    (assert (in "id=\"regex-literal\"" reader-macros))
    (assert (in "class=\"previous\" href=\"/docs/reference/language/lexical-syntax/\"" reader-macros))
    (assert (in "class=\"next\" href=\"/docs/reference/language/data-structures/\"" reader-macros))
    (assert (in "<script defer src=\"/docs-search.js\"></script>" search))
    (assert (in "data-docs-search" search))
    (assert (in "\"route\":\"/docs/language/\"" search-index))
    (assert (in "\"route\":\"/docs/reference/language/functions/\"" search-index))
    (assert (in "\"route\":\"/docs/reference/language/reader-macros/\"" search-index))
    (assert (not (in "\"route\":\"/docs/reference/standard-library/reader-macros/\"" search-index)))
    (assert (in "\"route\":\"/docs/reference/standard-library/sequences/\"" search-index))
    (assert (in "\"route\":\"/docs/reference/tooling/manifest/\"" search-index))
    (assert (in "\"route\":\"/docs/packages/spork-pds/guide/\"" search-index))
    (assert (in "\"route\":\"/docs/packages/spork-state/api/\"" search-index))
    (assert (in "\"route\":\"/docs/packages/spork-site/markup/\"" search-index))
    (assert (in "\"route\":\"/docs/editors/emacs/\"" search-index))
    (assert (in "\"route\":\"/docs/examples/command-provider/\"" search-index))))

(deftest installer-checksum-is-calculated-into-the-page-and-output
  (let [checksum (subject.installer-sha256)
        summary (build.check-site (subject.make-site))
        plan (:plan summary)
        guide (.decode (:content (plan-entry plan "/docs/getting-started/")) "utf-8")
        checksum-file (.decode (:content (plan-entry plan "/install.sha256")) "utf-8")]
    (assert (= (len checksum) 64))
    (assert (in checksum guide))
    (assert (< (guide.index "language-bash")
               (guide.index "current installer / SHA-256")))
    (assert (not (in "<!-- installer-verification -->" guide)))
    (assert (= checksum-file (+ checksum "  install\n")))))

(deftest generated-discovery-files-use-the-production-origin
  (let [summary (build.check-site (subject.make-site))
        plan (:plan summary)
        robots (.decode (:content (plan-entry plan "/robots.txt")) "utf-8")
        sitemap (.decode (:content (plan-entry plan "/sitemap.xml")) "utf-8")]
    (assert (in "Sitemap: https://spork.sh/sitemap.xml" robots))
    (assert (in "<loc>https://spork.sh/docs/</loc>" sitemap))
    (assert (in "<loc>https://spork.sh/get/</loc>" sitemap))
    (assert (not (in "https://spork.sh/ecosystem/" sitemap)))
    (assert (not (in "https://spork.sh/404.html" sitemap)))))
